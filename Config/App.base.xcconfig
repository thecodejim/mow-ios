# Shared keys that every environment inherits.

INFOPLIST_KEY_MOWEnvironmentName = $(APP_ENVIRONMENT_NAME)
INFOPLIST_KEY_MOWAPIBaseURL = $(API_BASE_URL)
INFOPLIST_KEY_MOWDocsURL = $(DOCS_BASE_URL)
INFOPLIST_KEY_MOWPortalURL = $(PORTAL_URL)
INFOPLIST_KEY_MOWTelemetryURL = $(TELEMETRY_URL)
INFOPLIST_KEY_MOWHealthCheckToken = $(HEALTH_CHECK_TOKEN)
INFOPLIST_KEY_MOWUseMockData = $(USE_MOCK_DATA)
INFOPLIST_KEY_MOWLogLevel = $(LOG_LEVEL)

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(APP_SWIFT_FLAGS)

